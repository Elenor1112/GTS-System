// GTS — Business Operating System.
//
// Design rules this schema obeys:
//   * Money is Decimal(14,2) — never Float. Egyptian invoices are quoted
//     to piastres and a tax authority will re-derive every total.
//   * Timestamps are @db.Timestamptz(3). The business runs in Africa/Cairo
//     but stores UTC; a naive timestamp would shift by an hour for half
//     the year once summer time starts.
//   * Stock is never a freely writable column. `WarehouseStock.quantity`
//     is a projection maintained ONLY inside the same transaction that
//     appends an InventoryTransaction row. The ledger is the truth.
//   * Soft deletion (`deletedAt`) on entities a business must retain for
//     audit; hard deletion only on join rows that carry no history.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved connection URLs out of the schema. They live in
// ../prisma.config.ts, which points Migrate at the DIRECT (non-pooled)
// Neon endpoint — PgBouncer in transaction mode cannot hold the
// session-level advisory locks migrations take. The application itself
// connects through the pooled endpoint via the Neon driver adapter in
// src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

/* ============================================================
   IDENTITY, ROLES, PERMISSIONS
   ============================================================ */

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  nameEn       String
  nameAr       String?
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  employee Employee?

  sessions      Session[]
  auditLogs     AuditLog[]
  notifications Notification[]

  // Actions this user took on other people's records.
  approvedLeaves    LeaveRequest[]         @relation("LeaveApprover")
  billApprovals     BillApproval[]
  inventoryEntries  InventoryTransaction[]
  paymentsRecorded  Payment[]
  documentsUploaded Document[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([roleId])
  @@index([deletedAt])
  @@map("users")
}

/// Server-side sessions. The cookie carries only an opaque token; every
/// request resolves it here, so revoking a session is immediate and a
/// stolen cookie cannot outlive its row.
model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the cookie value. The raw token is never stored, so a
  /// database leak does not hand over live sessions.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  nameEn      String
  nameAr      String?
  description String?
  /// The administrator role holds every permission implicitly and cannot
  /// be deleted or stripped — otherwise a mis-click can lock everyone out.
  isSystem    Boolean @default(false)

  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  /// Dotted key, e.g. "bills.approve". This string is what server-side
  /// guards check; it is the real authorization surface.
  key         String @unique
  module      String
  action      String
  description String

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/* ============================================================
   PEOPLE
   ============================================================ */

model Employee {
  id     String  @id @default(cuid())
  code   String  @unique
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  nameEn String
  nameAr String?
  /// 14 digits, structurally validated. Unique because two employee
  /// records sharing a national ID is a duplicate, not a family.
  nationalId  String? @unique
  /// 9 digits, issued for payroll.
  insuranceNo String?
  jobTitleEn  String
  jobTitleAr  String?
  department  String?
  phone       String?
  email       String?
  hiredOn     DateTime  @db.Date
  endedOn     DateTime? @db.Date
  isActive    Boolean   @default(true)

  /// Daily wage, used to cost attendance against a project.
  dailyRate Decimal? @db.Decimal(14, 2)

  projects      ProjectEmployee[]
  attendance    Attendance[]
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([isActive])
  @@index([deletedAt])
  @@map("employees")
}

/* ============================================================
   COUNTERPARTIES
   ============================================================ */

model Client {
  id     String  @id @default(cuid())
  code   String  @unique
  nameEn String
  nameAr String?
  /// 9-digit Egyptian Tax Registration Number. Unique: one TRN is one
  /// legal entity, and billing the same TRN under two records breaks
  /// the VAT return.
  trn              String? @unique
  commercialRegNo  String?
  governorateCode  Int?
  addressLine      String?
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  /// Days from issue to due, applied when a bill is raised.
  paymentTermsDays Int     @default(30)
  /// Above this outstanding balance, new bills warn. 0 = no limit.
  creditLimit      Decimal @default(0) @db.Decimal(14, 2)
  notes            String?
  isActive         Boolean @default(true)

  projects     Project[]
  bills        ElectronicBill[]
  payments     Payment[]
  transactions ClientProductTransaction[]
  documents    Document[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([isActive])
  @@index([deletedAt])
  @@index([nameEn])
  @@map("clients")
}

model Vendor {
  id               String  @id @default(cuid())
  code             String  @unique
  nameEn           String
  nameAr           String?
  trn              String? @unique
  commercialRegNo  String?
  governorateCode  Int?
  field            String?
  addressLine      String?
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  paymentTermsDays Int     @default(30)
  notes            String?
  isActive         Boolean @default(true)

  products     Product[]
  bills        ElectronicBill[]
  payments     Payment[]
  transactions VendorProductTransaction[]
  documents    Document[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([isActive])
  @@index([deletedAt])
  @@index([nameEn])
  @@map("vendors")
}

/* ============================================================
   PROJECTS
   ============================================================ */

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id       String        @id @default(cuid())
  code     String        @unique
  nameEn   String
  nameAr   String?
  clientId String
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status   ProjectStatus @default(PLANNING)

  startsOn DateTime? @db.Date
  endsOn   DateTime? @db.Date
  budget   Decimal?  @db.Decimal(14, 2)
  notes    String?

  location              ProjectLocation?
  employees             ProjectEmployee[]
  products              ProjectProduct[]
  bills                 ElectronicBill[]
  attendance            Attendance[]
  inventoryTransactions InventoryTransaction[]
  clientTransactions    ClientProductTransaction[]
  documents             Document[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([clientId])
  @@index([status])
  @@index([deletedAt])
  @@map("projects")
}

/// The physical site. Separated from Project because the geofence is a
/// distinct concern with its own audit trail — moving a site boundary is
/// a security-relevant act, and one project has exactly one official
/// location that only an administrator may set.
model ProjectLocation {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  addressLine     String
  governorateCode Int
  /// WGS-84. Decimal, not Float: a rounded coordinate moves the fence.
  latitude        Decimal @db.Decimal(9, 6)
  longitude       Decimal @db.Decimal(9, 6)
  /// Accepted check-in radius, metres.
  radiusMetres    Int     @default(200)
  siteType        String  @default("site")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("project_locations")
}

model ProjectEmployee {
  id         String    @id @default(cuid())
  projectId  String
  employeeId String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleOnSite String?
  assignedOn DateTime  @db.Date
  releasedOn DateTime? @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// One assignment per person per project per start date. A released
  /// assignment keeps its row so history survives re-assignment.
  @@unique([projectId, employeeId, assignedOn])
  @@index([employeeId])
  @@index([projectId])
  @@map("project_employees")
}

/* ============================================================
   CATALOGUE & WAREHOUSES
   ============================================================ */

model ProductCategory {
  id       String    @id @default(cuid())
  nameEn   String    @unique
  nameAr   String?
  products Product[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("product_categories")
}

model Product {
  id         String           @id @default(cuid())
  sku        String           @unique
  nameEn     String
  nameAr     String?
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendorId   String?
  vendor     Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  brand String?
  /// ETA unit-of-measure code: EA, BG, MTR, MTQ, MTK, HUR.
  unit  String  @default("EA")
  /// GS1 GPC or taxpayer EGS code. Mandatory before a bill line using
  /// this product can be submitted to the ETA.
  gpcCode String?

  costPrice Decimal @default(0) @db.Decimal(14, 2)
  salePrice Decimal @default(0) @db.Decimal(14, 2)
  /// Per-line VAT rate; a zero-rated export item is not 14%.
  vatRate   Decimal @default(14) @db.Decimal(5, 2)

  /// Notify when total stock across warehouses falls below this.
  reorderLevel Decimal @default(0) @db.Decimal(14, 3)
  isActive     Boolean @default(true)

  stock                 WarehouseStock[]
  inventoryTransactions InventoryTransaction[]
  projectProducts       ProjectProduct[]
  billItems             BillItem[]
  clientTransactions    ClientProductTransaction[]
  vendorTransactions    VendorProductTransaction[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([categoryId])
  @@index([vendorId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([nameEn])
  @@map("products")
}

model Warehouse {
  id     String  @id @default(cuid())
  code   String  @unique
  nameEn String
  nameAr String?

  governorateCode Int?
  addressLine     String?
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  /// Nominal capacity in cubic metres, for the utilisation gauge.
  capacityM3      Decimal? @db.Decimal(12, 2)
  managerId       String?
  isActive        Boolean  @default(true)

  stock       WarehouseStock[]
  transactions InventoryTransaction[] @relation("TxWarehouse")
  transfersIn  InventoryTransaction[] @relation("TxDestination")

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([isActive])
  @@index([deletedAt])
  @@map("warehouses")
}

/// Stock on hand, per product per warehouse.
///
/// THIS IS A PROJECTION, NOT A SOURCE OF TRUTH. It exists so a stock
/// query does not have to sum the whole ledger. It is only ever written
/// inside the transaction that appends the corresponding
/// InventoryTransaction row, and a CHECK constraint (added by migration)
/// forbids it going negative.
model WarehouseStock {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// 3 decimal places: aggregate and cable are issued in fractions.
  quantity    Decimal @default(0) @db.Decimal(14, 3)
  /// Physically present but committed to a project allocation.
  reserved    Decimal @default(0) @db.Decimal(14, 3)
  binLocation String?

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("warehouse_stock")
}

/* ============================================================
   THE INVENTORY LEDGER
   ============================================================ */

enum InventoryTxType {
  RECEIVE
  ISSUE
  TRANSFER
  RETURN
  DAMAGE
  ADJUSTMENT
  PROJECT_ALLOCATION
}

/// Append-only. Every movement of every unit is one row here, and stock
/// levels are derived from it. Rows are never updated or deleted — a
/// mistake is corrected by an offsetting ADJUSTMENT, so the history of
/// what was believed, and when, survives.
model InventoryTransaction {
  id   String          @id @default(cuid())
  /// Human reference, e.g. TX-2026-000123. Gapless per year.
  ref  String          @unique
  type InventoryTxType

  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse   Warehouse @relation("TxWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)

  /// Destination warehouse — TRANSFER only.
  destinationWarehouseId String?
  destinationWarehouse   Warehouse? @relation("TxDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)

  /// Signed against the affected warehouse: positive adds, negative
  /// removes. A TRANSFER writes one negative row on the source and one
  /// positive row on the destination, linked by `groupRef`, so neither
  /// warehouse's ledger has a hole.
  quantity     Decimal  @db.Decimal(14, 3)
  /// Stock level in the affected warehouse AFTER this row was applied.
  /// Stored so a historical statement renders without replaying the
  /// entire ledger.
  balanceAfter Decimal  @db.Decimal(14, 3)
  unitCost     Decimal? @db.Decimal(14, 2)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Links the two halves of a transfer, or a batch posted together.
  groupRef String?
  reason   String?
  notes    String?

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id], onDelete: Restrict)

  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([productId, occurredAt])
  @@index([warehouseId, occurredAt])
  @@index([projectId])
  @@index([type])
  @@index([groupRef])
  @@map("inventory_transactions")
}

/// Running position of one product on one project.
///
/// Also a projection, maintained inside the allocation/delivery/return
/// transaction. `remaining` is derived: allocated − returned − damaged.
model ProjectProduct {
  id        String  @id @default(cuid())
  projectId String
  productId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  allocated Decimal @default(0) @db.Decimal(14, 3)
  delivered Decimal @default(0) @db.Decimal(14, 3)
  returned  Decimal @default(0) @db.Decimal(14, 3)
  damaged   Decimal @default(0) @db.Decimal(14, 3)

  /// Price agreed for this project, which may differ from the catalogue.
  agreedPrice Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([projectId, productId])
  @@index([productId])
  @@map("project_products")
}

/// Goods movements viewed from the CLIENT's side — what they received,
/// returned or damaged. Derived from the same events as the inventory
/// ledger, kept separately because the client statement must survive a
/// project being closed or re-coded.
model ClientProductTransaction {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// DELIVERED | RETURNED | DAMAGED
  direction  String
  quantity   Decimal  @db.Decimal(14, 3)
  unitPrice  Decimal? @db.Decimal(14, 2)
  reference  String?
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([clientId, occurredAt])
  @@index([projectId])
  @@index([productId])
  @@map("client_product_transactions")
}

/// The vendor's side: goods received from a supplier, and returns to them.
model VendorProductTransaction {
  id        String  @id @default(cuid())
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// RECEIVED | RETURNED
  direction  String
  quantity   Decimal  @db.Decimal(14, 3)
  unitCost   Decimal? @db.Decimal(14, 2)
  reference  String?
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([vendorId, occurredAt])
  @@index([productId])
  @@map("vendor_product_transactions")
}

/* ============================================================
   BILLING
   ============================================================ */

enum BillStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum BillDirection {
  /// Issued by us to a client — a receivable.
  RECEIVABLE
  /// Issued to us by a vendor — a payable.
  PAYABLE
}

enum EtaDocumentType {
  I
  C
  D
}

model ElectronicBill {
  id           String          @id @default(cuid())
  /// Gapless per year and direction. A gap reads as a suppressed sale to
  /// the Egyptian Tax Authority, so it is allocated inside the insert
  /// transaction from a locked counter row, never from a count().
  number       String          @unique
  direction    BillDirection
  documentType EtaDocumentType @default(I)
  status       BillStatus      @default(DRAFT)

  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vendorId  String?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  issuedOn DateTime @db.Date
  dueOn    DateTime @db.Date

  currency     String   @default("EGP")
  exchangeRate Decimal? @db.Decimal(12, 6)

  /// EVERY figure below is computed server-side from BillItem rows by
  /// computeTotals(). A total posted by a browser is never written here.
  subtotal   Decimal @default(0) @db.Decimal(14, 2)
  discount   Decimal @default(0) @db.Decimal(14, 2)
  net        Decimal @default(0) @db.Decimal(14, 2)
  vatAmount  Decimal @default(0) @db.Decimal(14, 2)
  total      Decimal @default(0) @db.Decimal(14, 2)
  /// Withholding tax the buyer deducts at payment. Reduces cash received,
  /// never the invoice total — so it is stored beside the total, not in it.
  whtRate    Decimal @default(0) @db.Decimal(5, 2)
  whtAmount  Decimal @default(0) @db.Decimal(14, 2)
  paidAmount Decimal @default(0) @db.Decimal(14, 2)

  notes String?

  /// ETA-assigned. Null until a real submission happens — inventing a
  /// UUID here would fabricate a compliance record.
  etaUuid        String?
  etaLongId      String?
  etaStatus      String    @default("NOT_SUBMITTED")
  etaSubmittedAt DateTime? @db.Timestamptz(3)

  items     BillItem[]
  payments  Payment[]
  approvals BillApproval[]
  documents Document[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([clientId])
  @@index([vendorId])
  @@index([projectId])
  @@index([status])
  @@index([direction, status])
  @@index([dueOn])
  @@index([deletedAt])
  @@map("electronic_bills")
}

model BillItem {
  id     String         @id @default(cuid())
  billId String
  bill   ElectronicBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Description is COPIED, not joined. A bill is a legal document: it
  /// must still read correctly after the catalogue is renamed.
  descriptionEn String
  descriptionAr String?
  itemCode      String?
  gpcCode       String?

  quantity  Decimal @db.Decimal(14, 3)
  unit      String  @default("EA")
  unitPrice Decimal @db.Decimal(14, 2)
  discount  Decimal @default(0) @db.Decimal(14, 2)
  vatRate   Decimal @default(14) @db.Decimal(5, 2)

  /// Per-line derived figures, written by the server's totals engine.
  lineNet   Decimal @db.Decimal(14, 2)
  lineVat   Decimal @db.Decimal(14, 2)
  lineTotal Decimal @db.Decimal(14, 2)

  sortOrder Int @default(0)

  @@index([billId])
  @@index([productId])
  @@map("bill_items")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

model Payment {
  id     String          @id @default(cuid())
  ref    String          @unique
  billId String?
  bill   ElectronicBill? @relation(fields: [billId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  amount      Decimal       @db.Decimal(14, 2)
  /// Withholding the payer deducted from this specific payment.
  whtDeducted Decimal       @default(0) @db.Decimal(14, 2)
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?

  receivedOn DateTime @db.Date

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([billId])
  @@index([clientId, receivedOn])
  @@index([vendorId, receivedOn])
  @@map("payments")
}

/// Who moved a bill between states, and why. Approval is an audited act
/// with its own history, not a status column overwritten in place.
model BillApproval {
  id     String         @id @default(cuid())
  billId String
  bill   ElectronicBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  /// SUBMITTED | APPROVED | REJECTED | CANCELLED | SENT
  action     String
  fromStatus BillStatus
  toStatus   BillStatus
  note       String?

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([billId, createdAt])
  @@map("bill_approvals")
}

/* ============================================================
   ATTENDANCE
   ============================================================ */

enum AttendanceStatus {
  ATTENDED
  LATE
  MISSED
  ON_LEAVE
}

/// A check-in is a claim by a device until the SERVER re-runs the
/// geofence. `distanceMetres` and `status` here are the server's own
/// verdict, computed from the stored coordinates against the project
/// location — never copied from the request body.
model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  /// The Cairo calendar date this record belongs to. Derived server-side
  /// from checkInAt in Africa/Cairo, which is what makes the one-per-day
  /// unique constraint mean what a human means by "today".
  workDate DateTime @db.Date

  checkInAt  DateTime  @db.Timestamptz(3)
  checkOutAt DateTime? @db.Timestamptz(3)

  /// Raw device fix, retained for audit even when accepted.
  checkInLat      Decimal  @db.Decimal(9, 6)
  checkInLng      Decimal  @db.Decimal(9, 6)
  checkInAccuracy Decimal? @db.Decimal(8, 2)
  checkOutLat     Decimal? @db.Decimal(9, 6)
  checkOutLng     Decimal? @db.Decimal(9, 6)

  /// Server-computed Haversine distance to the site centre, metres.
  distanceMetres  Int
  /// Fence radius in force at the moment of check-in. Stored because an
  /// administrator may widen the fence later, and that must not
  /// retroactively legitimise a past check-in.
  radiusAtCheckIn Int

  status        AttendanceStatus @default(ATTENDED)
  minutesLate   Int              @default(0)
  workedMinutes Int?
  notes         String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// One check-in per employee per project per Cairo day. This is the
  /// duplicate-check-in defence, enforced by the database rather than by
  /// a read-then-write race in application code.
  @@unique([employeeId, projectId, workDate])
  @@index([projectId, workDate])
  @@index([employeeId, workDate])
  @@index([workDate])
  @@map("attendance")
}

/* ============================================================
   LEAVE
   ============================================================ */

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id     String  @id @default(cuid())
  key    String  @unique
  nameEn String
  nameAr String?
  /// Statutory annual entitlement in days (Egyptian Labour Law 12/2003
  /// gives 21 days, rising to 30 after ten years' service or age 50).
  defaultDays      Int     @default(0)
  isPaid           Boolean @default(true)
  requiresDocument Boolean @default(false)

  requests LeaveRequest[]
  balances LeaveBalance[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("leave_types")
}

/// Entitlement and consumption, per employee per type per year.
model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  leaveTypeId String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  year     Int
  entitled Decimal @default(0) @db.Decimal(6, 2)
  taken    Decimal @default(0) @db.Decimal(6, 2)
  /// Requested but not yet decided — held so two requests cannot both
  /// spend the same remaining day.
  pending  Decimal @default(0) @db.Decimal(6, 2)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@map("leave_balances")
}

model LeaveRequest {
  id          String    @id @default(cuid())
  ref         String    @unique
  employeeId  String
  leaveTypeId String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  startsOn DateTime @db.Date
  endsOn   DateTime @db.Date
  /// Working days only — Friday and Saturday are the Egyptian weekend and
  /// are not deducted from a balance.
  workingDays Decimal @db.Decimal(6, 2)
  reason      String?

  status LeaveStatus @default(PENDING)

  approverId   String?
  approver     User?     @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt    DateTime? @db.Timestamptz(3)
  decisionNote String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([employeeId, startsOn])
  @@index([status])
  @@map("leave_requests")
}

/* ============================================================
   CROSS-CUTTING
   ============================================================ */

enum NotificationKind {
  LEAVE_REQUESTED
  LEAVE_DECIDED
  BILL_PENDING_APPROVAL
  BILL_APPROVED
  BILL_OVERDUE
  LOW_INVENTORY
  PROJECT_ASSIGNED
  ATTENDANCE_ISSUE
  PAYMENT_RECEIVED
  SYSTEM
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   NotificationKind

  titleEn String
  titleAr String?
  bodyEn  String
  bodyAr  String?
  /// Where clicking it goes, e.g. /bills/clx123.
  href    String?

  /// The record this is about, for de-duplication.
  entityType String?
  entityId   String?

  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Document {
  id        String @id @default(cuid())
  filename  String
  mimeType  String
  sizeBytes Int
  /// Path within the server-side upload root. Files are never served from
  /// a public directory; a route checks permission then streams.
  storageKey String  @unique
  checksum   String?

  entityType String
  entityId   String

  clientId  String?
  client    Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendorId  String?
  vendor    Vendor?         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  billId    String?
  bill      ElectronicBill? @relation(fields: [billId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@map("documents")
}

/// Append-only record of who did what. Written inside the same
/// transaction as the change it describes, so an action cannot succeed
/// while its audit entry silently fails.
model AuditLog {
  id String @id @default(cuid())

  /// Nullable: a failed sign-in has no authenticated actor yet, and that
  /// is exactly the event worth recording.
  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?

  /// CREATE | UPDATE | DELETE | APPROVE | REJECT | LOGIN | LOGIN_FAILED …
  action     String
  entityType String
  entityId   String?
  summary    String?

  /// Only the fields that changed, as { field: { from, to } }. Password
  /// hashes and tokens are stripped before writing.
  beforeState Json?
  afterState  Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

/// Tenant-wide configuration an administrator controls: geofence
/// defaults, working hours, late threshold, tax identity.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("settings")
}

/// Gapless per-year counters for bill numbers, inventory refs and leave
/// refs. Incremented with a row lock inside the issuing transaction, so
/// two concurrent requests cannot take the same number.
model Counter {
  key   String @id
  value Int    @default(0)

  @@map("counters")
}
