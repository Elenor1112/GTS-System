# GTS — environment. Copy to .env and fill in. Never commit .env.

# Neon Postgres: pooled endpoint at runtime, direct endpoint for Migrate.
DATABASE_URL=
DIRECT_URL=
SHADOW_DATABASE_URL=

SESSION_SECRET=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Egyptian Tax Authority e-invoicing. ETA_ENV is `preprod` or `production`.
# The ETA issues two client secrets so one can be rotated while the other
# keeps working; either is accepted.
ETA_ENV=preprod
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
ETA_CLIENT_SECRET_2=
