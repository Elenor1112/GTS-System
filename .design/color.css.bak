/* ============================================================
   GTS — COLOR SYSTEM
   ------------------------------------------------------------
   Built in OKLCH so every ramp is perceptually even and the
   dark theme is a lightness inversion, not a hand-tuned fork.

   Foundation is INK, not blue: a warm-cooled near-black with a
   faint indigo cast (H 265) that reads as "expensive print"
   rather than "default UI". Brand accent is DEEP BRASS — an
   ochre/amber that is rare in enterprise software, works on
   both light and dark ink, and never reads as a warning when
   used structurally (warning owns a distinctly redder hue).
   ============================================================ */

:root {
  /* ---------- INK RAMP (foundation) --------------------- */
  --gts-ink-00:  oklch(99.2%  0.003 265); /* page, light        */
  --gts-ink-05:  oklch(97.4%  0.005 265);
  --gts-ink-10:  oklch(94.6%  0.007 265);
  --gts-ink-15:  oklch(91.0%  0.009 265); /* hairlines          */
  --gts-ink-20:  oklch(86.0%  0.011 265);
  --gts-ink-30:  oklch(74.0%  0.014 265);
  --gts-ink-40:  oklch(62.0%  0.017 265); /* disabled text      */
  --gts-ink-50:  oklch(52.0%  0.019 265); /* metadata           */
  --gts-ink-60:  oklch(43.0%  0.021 265); /* secondary text     */
  --gts-ink-70:  oklch(34.0%  0.024 265);
  --gts-ink-80:  oklch(25.5%  0.026 265); /* primary text       */
  --gts-ink-90:  oklch(18.0%  0.028 265);
  --gts-ink-95:  oklch(13.5%  0.030 265); /* dark surface       */
  --gts-ink-100: oklch(9.5%   0.032 265); /* dark page          */

  /* ---------- BRAND: DEEP BRASS ------------------------- */
  --gts-brass-05: oklch(97.0% 0.022 75);
  --gts-brass-10: oklch(93.5% 0.045 75);
  --gts-brass-20: oklch(87.0% 0.082 75);
  --gts-brass-30: oklch(79.0% 0.110 72);
  --gts-brass-40: oklch(71.0% 0.128 70);
  --gts-brass-50: oklch(55.5% 0.128 66); /* brand primary (AA w/ white text) */
  --gts-brass-60: oklch(48.0% 0.112 64);
  --gts-brass-70: oklch(46.0% 0.105 64);
  --gts-brass-80: oklch(36.0% 0.082 62);
  --gts-brass-90: oklch(26.0% 0.058 60);

  /* ---------- SEMANTIC HUES -----------------------------
     Each is a full ramp so states have fg/bg/border variants
     that pass contrast without per-use guessing. */

  /* SUCCESS — deep verdigris green, not "app store green" */
  --gts-success-05: oklch(96.8% 0.020 165);
  --gts-success-10: oklch(92.5% 0.042 165);
  --gts-success-30: oklch(76.0% 0.098 163);
  --gts-success-50: oklch(58.0% 0.106 161);
  --gts-success-60: oklch(49.5% 0.096 160);
  --gts-success-80: oklch(32.0% 0.062 160);

  /* WARNING — amber, pushed redder than brass to stay distinct */
  --gts-warning-05: oklch(97.2% 0.028 92);
  --gts-warning-10: oklch(93.8% 0.060 92);
  --gts-warning-30: oklch(83.0% 0.130 88);
  --gts-warning-50: oklch(70.0% 0.155 78);
  --gts-warning-60: oklch(61.0% 0.142 74);
  --gts-warning-80: oklch(40.0% 0.092 72);

  /* DANGER — oxidized red, serious not alarming */
  --gts-danger-05: oklch(96.8% 0.018 24);
  --gts-danger-10: oklch(93.0% 0.040 24);
  --gts-danger-30: oklch(74.0% 0.130 25);
  --gts-danger-50: oklch(57.0% 0.185 26);
  --gts-danger-60: oklch(49.0% 0.170 26);
  --gts-danger-80: oklch(33.0% 0.110 26);

  /* INFO — slate-teal. Deliberately NOT the brand color, so
     informational never competes with primary action. */
  --gts-info-05: oklch(96.8% 0.016 232);
  --gts-info-10: oklch(92.6% 0.036 232);
  --gts-info-30: oklch(75.0% 0.086 230);
  --gts-info-50: oklch(57.0% 0.098 228);
  --gts-info-60: oklch(48.5% 0.090 228);
  --gts-info-80: oklch(32.0% 0.058 228);
}

/* ============================================================
   DOMAIN ACCENTS
   ------------------------------------------------------------
   Each functional area owns a hue. Unity comes from all of them
   sharing the SAME chroma/lightness discipline and the same ink
   foundation — only hue rotates. The accent appears in a strictly
   limited surface area: module rail marker, section rules,
   chart primary series, active nav state, and data emphasis.
   It NEVER colors page backgrounds or body text.
   ============================================================ */

:root {
  /* FINANCE — analytical indigo-slate. Sober, "audited". */
  --gts-domain-finance:        oklch(52.0% 0.115 268);
  --gts-domain-finance-bright: oklch(66.0% 0.130 268);
  --gts-domain-finance-wash:   oklch(96.5% 0.018 268);

  /* INVENTORY — structural teal. Operational, gridded. */
  --gts-domain-inventory:        oklch(54.0% 0.100 205);
  --gts-domain-inventory-bright: oklch(68.0% 0.115 205);
  --gts-domain-inventory-wash:   oklch(96.5% 0.018 205);

  /* PROJECTS — energetic vermilion. Motion, delivery, momentum. */
  --gts-domain-projects:        oklch(52.5% 0.160 34);
  --gts-domain-projects-bright: oklch(70.0% 0.155 42);
  --gts-domain-projects-wash:   oklch(96.8% 0.022 40);

  /* CLIENTS — relationship violet. Human, warm-cool. */
  --gts-domain-clients:        oklch(53.0% 0.135 310);
  --gts-domain-clients-bright: oklch(67.0% 0.140 310);
  --gts-domain-clients-wash:   oklch(96.8% 0.020 310);

  /* VENDORS — supply bronze. Sibling to brass, clearly distinct. */
  --gts-domain-vendors:        oklch(52.0% 0.090 50);
  --gts-domain-vendors-bright: oklch(66.0% 0.105 50);
  --gts-domain-vendors-wash:   oklch(96.5% 0.020 50);

  /* ATTENDANCE — geographic green. Maps, presence, the human layer. */
  --gts-domain-attendance:        oklch(48.5% 0.110 155);
  --gts-domain-attendance-bright: oklch(69.0% 0.130 152);
  --gts-domain-attendance-wash:   oklch(96.5% 0.020 152);

  /* ADMIN / SYSTEM — neutral graphite. Intentionally colorless:
     configuration should feel like machinery, not a feature. */
  --gts-domain-admin:        oklch(46.0% 0.012 265);
  --gts-domain-admin-bright: oklch(62.0% 0.014 265);
  --gts-domain-admin-wash:   oklch(96.5% 0.005 265);
}

/* Scope a subtree to a domain: <main data-domain="finance">
   Components then read --gts-accent* and stay domain-agnostic. */
[data-domain='finance']    { --gts-accent: var(--gts-domain-finance);
                             --gts-accent-bright: var(--gts-domain-finance-bright);
                             --gts-accent-wash: var(--gts-domain-finance-wash); }
[data-domain='inventory']  { --gts-accent: var(--gts-domain-inventory);
                             --gts-accent-bright: var(--gts-domain-inventory-bright);
                             --gts-accent-wash: var(--gts-domain-inventory-wash); }
[data-domain='projects']   { --gts-accent: var(--gts-domain-projects);
                             --gts-accent-bright: var(--gts-domain-projects-bright);
                             --gts-accent-wash: var(--gts-domain-projects-wash); }
[data-domain='clients']    { --gts-accent: var(--gts-domain-clients);
                             --gts-accent-bright: var(--gts-domain-clients-bright);
                             --gts-accent-wash: var(--gts-domain-clients-wash); }
[data-domain='vendors']    { --gts-accent: var(--gts-domain-vendors);
                             --gts-accent-bright: var(--gts-domain-vendors-bright);
                             --gts-accent-wash: var(--gts-domain-vendors-wash); }
[data-domain='attendance'] { --gts-accent: var(--gts-domain-attendance);
                             --gts-accent-bright: var(--gts-domain-attendance-bright);
                             --gts-accent-wash: var(--gts-domain-attendance-wash); }
[data-domain='admin']      { --gts-accent: var(--gts-domain-admin);
                             --gts-accent-bright: var(--gts-domain-admin-bright);
                             --gts-accent-wash: var(--gts-domain-admin-wash); }

/* ============================================================
   APPLIED SEMANTIC LAYER — LIGHT
   Components consume ONLY these. Never a raw ramp step.
   ============================================================ */

:root {
  color-scheme: light;

  /* Surfaces. Note: NOT all white. The page is a warm off-white
     and raised surfaces go LIGHTER, so elevation reads without
     a shadow — this is what keeps the UI from being card soup. */
  --gts-bg-page:       var(--gts-ink-05);
  --gts-bg-surface:    var(--gts-ink-00);
  --gts-bg-raised:     var(--gts-ink-00);
  --gts-bg-sunken:     var(--gts-ink-10);
  --gts-bg-inset:      var(--gts-ink-10);
  --gts-bg-hover:      oklch(94.6% 0.007 265 / 0.7);
  --gts-bg-active:     var(--gts-ink-15);
  --gts-bg-selected:   var(--gts-accent-wash, var(--gts-ink-10));

  /* Inverse surface — used for the nav rail and command surfaces.
     A dark rail against a light workspace is the system's
     signature structural move. */
  --gts-bg-inverse:       var(--gts-ink-95);
  --gts-bg-inverse-raised:var(--gts-ink-90);
  --gts-fg-inverse:       var(--gts-ink-05);
  --gts-fg-inverse-muted: var(--gts-ink-30);

  /* Foreground */
  --gts-fg-primary:   var(--gts-ink-90);
  --gts-fg-secondary: var(--gts-ink-60);
  --gts-fg-muted:     var(--gts-ink-50);
  --gts-fg-disabled:  var(--gts-ink-40);
  --gts-fg-on-accent: var(--gts-ink-00);

  /* Borders — three weights only. Hairline does most of the work. */
  --gts-border-hairline: var(--gts-ink-15);
  --gts-border-default:  var(--gts-ink-20);
  --gts-border-strong:   var(--gts-ink-30);
  --gts-border-inverse:  oklch(100% 0 0 / 0.12);

  /* Semantic foreground/background pairs (WCAG AA on their bg) */
  --gts-success-fg: var(--gts-success-60);
  --gts-success-bg: var(--gts-success-05);
  --gts-success-br: var(--gts-success-30);
  --gts-warning-fg: var(--gts-warning-80);
  --gts-warning-bg: var(--gts-warning-05);
  --gts-warning-br: var(--gts-warning-30);
  --gts-danger-fg:  var(--gts-danger-60);
  --gts-danger-bg:  var(--gts-danger-05);
  --gts-danger-br:  var(--gts-danger-30);
  --gts-info-fg:    var(--gts-info-60);
  --gts-info-bg:    var(--gts-info-05);
  --gts-info-br:    var(--gts-info-30);
  --gts-neutral-fg: var(--gts-ink-60);
  --gts-neutral-bg: var(--gts-ink-10);
  --gts-neutral-br: var(--gts-ink-20);

  --gts-brand:      var(--gts-brass-50);
  --gts-brand-fg:   var(--gts-brass-70);
  --gts-brand-bg:   var(--gts-brass-05);
  --gts-focus-ring: var(--gts-brass-50);

  /* Default accent when no [data-domain] is scoped */
  --gts-accent:        var(--gts-brass-50);
  --gts-accent-bright: var(--gts-brass-40);
  --gts-accent-wash:   var(--gts-brass-05);

  /* Data-viz categorical sequence — hue-ordered, equal chroma,
     distinguishable in both themes and for deuteranopia. */
  --gts-viz-1: oklch(52.0% 0.115 268);
  --gts-viz-2: oklch(52.5% 0.160 34);
  --gts-viz-3: oklch(54.0% 0.100 205);
  --gts-viz-4: oklch(55.5% 0.128 66);
  --gts-viz-5: oklch(53.0% 0.135 310);
  --gts-viz-6: oklch(48.5% 0.110 155);
  --gts-viz-7: oklch(46.0% 0.012 265);
  /* Grid + axis: must recede behind data at all times. */
  --gts-viz-grid: var(--gts-ink-15);
  --gts-viz-axis: var(--gts-ink-40);
}

/* ============================================================
   DARK THEME
   Lightness inverts; hue and chroma discipline are preserved.
   Chroma is REDUCED on dark to prevent halation on OLED.
   ============================================================ */

@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) { color-scheme: dark; }
}
:root[data-theme='dark'] { color-scheme: dark; }

@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) {
    --gts-bg-page:        var(--gts-ink-100);
    --gts-bg-surface:     var(--gts-ink-95);
    --gts-bg-raised:      var(--gts-ink-90);
    --gts-bg-sunken:      oklch(7.0% 0.030 265);
    --gts-bg-inset:       oklch(7.0% 0.030 265);
    --gts-bg-hover:       oklch(100% 0 0 / 0.05);
    --gts-bg-active:      oklch(100% 0 0 / 0.09);
    --gts-bg-inverse:     var(--gts-ink-90);
    --gts-bg-inverse-raised: var(--gts-ink-80);
    --gts-fg-inverse:     var(--gts-ink-05);
    --gts-fg-inverse-muted: var(--gts-ink-40);

    --gts-fg-primary:   var(--gts-ink-05);
    --gts-fg-secondary: var(--gts-ink-30);
    --gts-fg-muted:     var(--gts-ink-40);
    --gts-fg-disabled:  var(--gts-ink-50);
    --gts-fg-on-accent: var(--gts-ink-100);

    --gts-border-hairline: oklch(100% 0 0 / 0.08);
    --gts-border-default:  oklch(100% 0 0 / 0.14);
    --gts-border-strong:   oklch(100% 0 0 / 0.24);
    --gts-border-inverse:  oklch(100% 0 0 / 0.14);

    --gts-success-fg: oklch(76.0% 0.090 163);
    --gts-success-bg: oklch(24.0% 0.048 162);
    --gts-success-br: oklch(38.0% 0.070 162);
    --gts-warning-fg: oklch(82.0% 0.115 85);
    --gts-warning-bg: oklch(26.0% 0.060 80);
    --gts-warning-br: oklch(40.0% 0.085 80);
    --gts-danger-fg:  oklch(75.0% 0.125 26);
    --gts-danger-bg:  oklch(25.0% 0.080 26);
    --gts-danger-br:  oklch(40.0% 0.110 26);
    --gts-info-fg:    oklch(76.0% 0.078 230);
    --gts-info-bg:    oklch(24.0% 0.045 230);
    --gts-info-br:    oklch(38.0% 0.062 230);
    --gts-neutral-fg: var(--gts-ink-30);
    --gts-neutral-bg: oklch(100% 0 0 / 0.06);
    --gts-neutral-br: oklch(100% 0 0 / 0.14);

    --gts-brand:      var(--gts-brass-40);
    --gts-brand-fg:   var(--gts-brass-30);
    --gts-brand-bg:   oklch(26.0% 0.055 66);
    --gts-focus-ring: var(--gts-brass-30);
    --gts-accent:        var(--gts-brass-40);
    --gts-accent-bright: var(--gts-brass-30);
    --gts-accent-wash:   oklch(24.0% 0.045 66);

    --gts-viz-1: oklch(70.0% 0.110 268);
    --gts-viz-2: oklch(72.0% 0.135 40);
    --gts-viz-3: oklch(72.0% 0.090 205);
    --gts-viz-4: oklch(76.0% 0.115 68);
    --gts-viz-5: oklch(71.0% 0.115 310);
    --gts-viz-6: oklch(72.0% 0.100 152);
    --gts-viz-7: oklch(68.0% 0.012 265);
    --gts-viz-grid: oklch(100% 0 0 / 0.08);
    --gts-viz-axis: var(--gts-ink-40);

    /* Domain accents brighten on dark to hold their identity. */
    --gts-domain-finance:    oklch(70.0% 0.110 268);
    --gts-domain-inventory:  oklch(72.0% 0.090 205);
    --gts-domain-projects:   oklch(72.0% 0.135 40);
    --gts-domain-clients:    oklch(71.0% 0.115 310);
    --gts-domain-vendors:    oklch(70.0% 0.090 50);
    --gts-domain-attendance: oklch(72.0% 0.100 152);
    --gts-domain-admin:      oklch(68.0% 0.012 265);
    --gts-domain-finance-wash:    oklch(24.0% 0.040 268);
    --gts-domain-inventory-wash:  oklch(24.0% 0.035 205);
    --gts-domain-projects-wash:   oklch(24.0% 0.048 40);
    --gts-domain-clients-wash:    oklch(24.0% 0.042 310);
    --gts-domain-vendors-wash:    oklch(24.0% 0.038 50);
    --gts-domain-attendance-wash: oklch(24.0% 0.038 152);
    --gts-domain-admin-wash:      oklch(22.0% 0.008 265);
  }
}

/* Manual dark toggle — same declarations, higher specificity so an
   explicit choice beats the OS preference in both directions. */
:root[data-theme='dark'] {
  --gts-bg-page:        var(--gts-ink-100);
  --gts-bg-surface:     var(--gts-ink-95);
  --gts-bg-raised:      var(--gts-ink-90);
  --gts-bg-sunken:      oklch(7.0% 0.030 265);
  --gts-bg-inset:       oklch(7.0% 0.030 265);
  --gts-bg-hover:       oklch(100% 0 0 / 0.05);
  --gts-bg-active:      oklch(100% 0 0 / 0.09);
  --gts-bg-inverse:     var(--gts-ink-90);
  --gts-bg-inverse-raised: var(--gts-ink-80);
  --gts-fg-inverse:     var(--gts-ink-05);
  --gts-fg-inverse-muted: var(--gts-ink-40);

  --gts-fg-primary:   var(--gts-ink-05);
  --gts-fg-secondary: var(--gts-ink-30);
  --gts-fg-muted:     var(--gts-ink-40);
  --gts-fg-disabled:  var(--gts-ink-50);
  --gts-fg-on-accent: var(--gts-ink-100);

  --gts-border-hairline: oklch(100% 0 0 / 0.08);
  --gts-border-default:  oklch(100% 0 0 / 0.14);
  --gts-border-strong:   oklch(100% 0 0 / 0.24);
  --gts-border-inverse:  oklch(100% 0 0 / 0.14);

  --gts-success-fg: oklch(76.0% 0.090 163);
  --gts-success-bg: oklch(24.0% 0.048 162);
  --gts-success-br: oklch(38.0% 0.070 162);
  --gts-warning-fg: oklch(82.0% 0.115 85);
  --gts-warning-bg: oklch(26.0% 0.060 80);
  --gts-warning-br: oklch(40.0% 0.085 80);
  --gts-danger-fg:  oklch(75.0% 0.125 26);
  --gts-danger-bg:  oklch(25.0% 0.080 26);
  --gts-danger-br:  oklch(40.0% 0.110 26);
  --gts-info-fg:    oklch(76.0% 0.078 230);
  --gts-info-bg:    oklch(24.0% 0.045 230);
  --gts-info-br:    oklch(38.0% 0.062 230);
  --gts-neutral-fg: var(--gts-ink-30);
  --gts-neutral-bg: oklch(100% 0 0 / 0.06);
  --gts-neutral-br: oklch(100% 0 0 / 0.14);

  --gts-brand:      var(--gts-brass-40);
  --gts-brand-fg:   var(--gts-brass-30);
  --gts-brand-bg:   oklch(26.0% 0.055 66);
  --gts-focus-ring: var(--gts-brass-30);
  --gts-accent:        var(--gts-brass-40);
  --gts-accent-bright: var(--gts-brass-30);
  --gts-accent-wash:   oklch(24.0% 0.045 66);

  --gts-viz-1: oklch(70.0% 0.110 268);
  --gts-viz-2: oklch(72.0% 0.135 40);
  --gts-viz-3: oklch(72.0% 0.090 205);
  --gts-viz-4: oklch(76.0% 0.115 68);
  --gts-viz-5: oklch(71.0% 0.115 310);
  --gts-viz-6: oklch(72.0% 0.100 152);
  --gts-viz-7: oklch(68.0% 0.012 265);
  --gts-viz-grid: oklch(100% 0 0 / 0.08);
  --gts-viz-axis: var(--gts-ink-40);

  /* Domain accents brighten on dark to hold their identity. */
  --gts-domain-finance:    oklch(70.0% 0.110 268);
  --gts-domain-inventory:  oklch(72.0% 0.090 205);
  --gts-domain-projects:   oklch(72.0% 0.135 40);
  --gts-domain-clients:    oklch(71.0% 0.115 310);
  --gts-domain-vendors:    oklch(70.0% 0.090 50);
  --gts-domain-attendance: oklch(72.0% 0.100 152);
  --gts-domain-admin:      oklch(68.0% 0.012 265);
  --gts-domain-finance-wash:    oklch(24.0% 0.040 268);
  --gts-domain-inventory-wash:  oklch(24.0% 0.035 205);
  --gts-domain-projects-wash:   oklch(24.0% 0.048 40);
  --gts-domain-clients-wash:    oklch(24.0% 0.042 310);
  --gts-domain-vendors-wash:    oklch(24.0% 0.038 50);
  --gts-domain-attendance-wash: oklch(24.0% 0.038 152);
  --gts-domain-admin-wash:      oklch(22.0% 0.008 265);
}
