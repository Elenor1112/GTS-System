{
  "name": "gts-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "start": "next start -p 3400",
    "typecheck": "tsc --noEmit",
    "contrast": "node design-system/contrast.mjs",
    "test": "vitest run && playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate",
    "test:server": "vitest run",
    "test:server:watch": "vitest",
    "test:e2e": "playwright test",
    "db:seed:activity": "vitest run --config vitest.seed.mts scripts/seed-activity.ts",
    "db:replenish": "vitest run --config vitest.seed.mts scripts/replenish.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "next": "^15.5.23",
    "postcss": "^8.5.26",
    "postcss-import": "^17.0.0",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
